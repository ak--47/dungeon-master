	// Vitest settings
	"vitest.rootConfig": "tests/alignment/regression-vitest.config.js",
	"vitest.configSearchPatternInclude": "tests/alignment/regression-vitest.config.js",
	"vitest.ignoreWorkspace": true,
	"vitest.nodeEnv": { "NODE_ENV": "test" },
	"vitest.logLevel": "info",
	// Test Explorer settings
	"testing.automaticallyOpenPeekView": "never",
	"testing.openTesting": "neverOpen",
	"js/ts.implicitProjectConfig.checkJs": true,
	// ESM and import settings
	"typescript.preferences.includePackageJsonAutoImports": "auto",
	"typescript.suggest.autoImports": true,
	"javascript.suggest.autoImports": true,
	// File associations
	"files.associations": {
		"*.js": "javascript",
		"*.mjs": "javascript",
		"*.cjs": "javascript"
	},
	// Search settings
	"search.exclude": {
		"**/node_modules": true,
		"**/coverage": true,
		"**/data": true,
		"**/tmp": true
	},
	"testing.automaticallyOpenTestResults": "neverOpen",
	// Disable non-Vitest test adapters for this workspace
	"go.testExplorer.enable": false,
	"batsTestExplorer.enabled": false,
	"batsTestExplorer.testAdapter": false,
	"mochaExplorer.enabled": false,
	"python.testing.pytestEnabled": false,
	"python.testing.unittestEnabled": false,
	"playwright.enabled": false
}