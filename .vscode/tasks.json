{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "test: regression (offline, macOS)",
            "type": "shell",
            "command": "set -o pipefail && /usr/bin/sandbox-exec -p '(version 1) (allow default) (deny network*)' node node_modules/vitest/vitest.mjs run --config tests/alignment/regression-vitest.config.js 2>&1 | tail -50",
            "options": { "cwd": "${workspaceFolder}", "env": { "NODE_ENV": "test", "NODE_OPTIONS": "", "VSCODE_INSPECTOR_OPTIONS": "" } },
            "group": { "kind": "test", "isDefault": true },
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "reveal": "always" }
        },
        {
            "label": "test: alignment (offline, macOS)",
            "type": "shell",
            "command": "set -o pipefail && node tests/alignment/run.mjs 2>&1 | tail -50",
            "options": { "cwd": "${workspaceFolder}", "env": { "NODE_OPTIONS": "", "VSCODE_INSPECTOR_OPTIONS": "" } },
            "group": "test",
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "reveal": "always" }
        },
        {
            "label": "test: alignment sweep (offline, max 10 minutes)",
            "type": "shell",
            "command": "set -o pipefail && node tests/alignment/run.mjs --sweep --timeout-ms=600000 2>&1 | tail -50",
            "options": { "cwd": "${workspaceFolder}", "env": { "NODE_OPTIONS": "", "VSCODE_INSPECTOR_OPTIONS": "" } },
            "group": "test",
            "problemMatcher": [],
            "presentation": { "panel": "dedicated", "reveal": "always" }
        },
        {
            "label": "test: engine matrix (list only, offline)",
            "type": "process",
            "command": "/usr/bin/sandbox-exec",
            "args": ["-p", "(version 1) (allow default) (deny network*)", "node", "tests/engine/sweep-engine.mjs", "--matrix-only"],
            "options": { "cwd": "${workspaceFolder}", "env": { "NODE_ENV": "test", "NODE_OPTIONS": "", "VSCODE_INSPECTOR_OPTIONS": "" } },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "test: engine short sweep (offline, opt-in)",
            "type": "process",
            "command": "/usr/bin/sandbox-exec",
            "args": ["-p", "(version 1) (allow default) (deny network*)", "node", "tests/engine/sweep-engine.mjs", "--tier", "short", "--workers", "1"],
            "options": { "cwd": "${workspaceFolder}", "env": { "NODE_ENV": "test", "NODE_OPTIONS": "", "VSCODE_INSPECTOR_OPTIONS": "" } },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "test: engine full sweep (offline, opt-in)",
            "type": "shell",
            "command": "set -o pipefail && /usr/bin/sandbox-exec -p '(version 1) (allow default) (deny network*)' node node_modules/vitest/vitest.mjs run --config vitest.editor.config.js tests/e2e/engine-shape-full-sweep.test.js 2>&1 | tail -50",
            "options": { "cwd": "${workspaceFolder}", "env": { "NODE_ENV": "test", "RUN_FULL_SWEEP": "1", "NODE_OPTIONS": "", "VSCODE_INSPECTOR_OPTIONS": "" } },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "typecheck",
            "type": "process",
            "command": "node",
            "args": ["${workspaceFolder}/node_modules/typescript/bin/tsc", "--noEmit"],
            "options": { "cwd": "${workspaceFolder}" },
            "problemMatcher": ["$tsc"]
        },
        {
            "label": "npm: prune",
            "type": "npm",
            "script": "prune",
            "group": "build",
            "problemMatcher": []
        },
        {
            // ── FAST PATH (no debugger) ──
            // js-debug ALWAYS attaches the V8 inspector to a launch.json
            // `type: node` config, and the inspector taxes the async-heavy
            // Mixpanel import ~30x (CPU pinned, ~0.68 rps). There is no way to
            // launch node without the inspector from launch.json, so the
            // no-debugger run lives here as a task = full-speed import (~43k eps).
            //
            // Trigger: open a dungeon file, then Cmd+Shift+B (this is the
            // default build task). Or bind a key to
            // "workbench.action.tasks.runTask" with arg "🚀 run dungeon".
            // Use the "🐞 debug dungeon" launch config only when you actually
            // want breakpoints.
            "label": "🚀 run dungeon",
            "type": "process",
            "command": "node",
            "args": ["${workspaceFolder}/scripts/run-dungeon.mjs", "${file}"],
            "options": {
                // Belt-and-suspenders: strip any auto-attach inspector injection
                // so the run stays fast regardless of Auto Attach mode.
                "env": { "NODE_OPTIONS": "", "VSCODE_INSPECTOR_OPTIONS": "" }
            },
            "dependsOn": ["npm: prune"],
            "dependsOrder": "sequence",
            "group": { "kind": "build", "isDefault": true },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated",
                "clear": true,
                "focus": true
            },
            "problemMatcher": []
        }
    ]
}
